%# This is an example of using NeASM as Python-based preprocessor
%#   for regular assembler code.
%# Preprocess this file by running `nepp.py example2.neasm >example2.asm`

%for n in range(4):
  paddq xmm{n+1}, xmm{n}

%for n in range(8,12):
  %start_new_stream()
  mov r{n}, [rbp+{n*8}]
  vmovdqu ymm{n}, [r{n}]
  vpcmpeqb ymm{n}, ymm0
  vpmovmskb r{n}, ymm{n}
  mov [rbp+{n*8}], r{n}
%interleave_streams()

%python
def xchg(a,b):
  %xor {a},{b}
  %xor {b},{a}
  %xor {a},{b}
  return ""

%asm
{xchg(si,di)}
{xchg(r8,r10)}

%equ('offs', 42)
addr equ EBX
value EQU EAX
mov [addr+offs], value

### Variable allocation example
%UNROLL = 4
register ptr, counter, sum
mov ptr, [rsp+40]
mov counter, 16 - {UNROLL}

start:
%for n in range(UNROLL):
  %start_new_stream()
  register sum{n}
  mov sum{n}, [ptr + counter*8 + {n}*8]
  %if n==0:
    add sum{n}, counter
  %else:
    lea sum{n}, [sum{n} + counter + {n}]
  mov [ptr + counter*8 + {n}*8], sum{n}
%interleave_streams()
sub counter, {UNROLL}
jae start

# Artificially extend variables' lifetime
mov counter, counter
mov ptr, ptr
