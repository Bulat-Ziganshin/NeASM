%# This is an example of using NeASM as Python-based preprocessor
%#   for regular assembler code.
%# Preprocess this file by running `nepp.py example2.neasm >example2.asm`

%for n in range(4):
  paddq xmm{n+1}, xmm{n}

%for n in range(8,12):
  %start_new_stream()
  mov r{n}, [ebp+{n*8}]
  vmovdqu ymm{n}, [r{n}]
  vpcmpeqb ymm{n}, ymm0
  vpmovmskb r{n}, ymm{n}
  mov [ebp+{n*8}], r{n}
%interleave_streams()

%python
def xchg(a,b):
  %xor {a},{b}
  %xor {b},{a}
  %xor {a},{b}
  return ""

%asm
{xchg(si,di)}
{xchg(r8,r10)}

%equ('offs', 42)
addr equ EBX
value EQU EAX
mov [addr+offs], value
